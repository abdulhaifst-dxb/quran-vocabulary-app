<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quranic Vocabulary Master (3,680 Words)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .arabic { font-family: 'Amiri', serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-600 text-white p-2 rounded-xl font-bold text-xl shadow">📖</div>
                <div>
                    <h1 class="text-xl font-bold text-white tracking-wide">Quranic Vocabulary Master</h1>
                    <p class="text-xs text-slate-400">Complete 3,680 Words, Roots, English & Tamil Database</p>
                </div>
            </div>
            <nav class="flex flex-wrap gap-2">
                <button onclick="switchTab('dashboard')" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-emerald-600 text-white transition shadow" id="btn-dashboard">Dashboard</button>
                <button onclick="switchTab('mcq')" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-slate-700 text-slate-300 hover:bg-slate-600 transition">MCQ Quiz</button>
                <button onclick="switchTab('root')" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-slate-700 text-slate-300 hover:bg-slate-600 transition">Root Detective</button>
                <button onclick="switchTab('speed')" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-slate-700 text-slate-300 hover:bg-slate-600 transition">Speed Match</button>
                <button onclick="switchTab('browser')" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-slate-700 text-slate-300 hover:bg-slate-600 transition">All 3,680 Words</button>
            </nav>
        </div>
    </header>
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6">
        <section id="tab-dashboard" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-slate-800 border border-slate-700 p-5 rounded-2xl shadow">
                    <p class="text-xs text-slate-400 uppercase font-semibold">Total Vocabulary</p>
                    <h3 class="text-3xl font-extrabold text-emerald-400 mt-1">3,680</h3>
                </div>
                <div class="bg-slate-800 border border-slate-700 p-5 rounded-2xl shadow">
                    <p class="text-xs text-slate-400 uppercase font-semibold">Languages</p>
                    <h3 class="text-3xl font-extrabold text-indigo-400 mt-1">Arabic ⇄ Tamil / Eng</h3>
                </div>
                <div class="bg-slate-800 border border-slate-700 p-5 rounded-2xl shadow">
                    <p class="text-xs text-slate-400 uppercase font-semibold">Quiz Score</p>
                    <h3 class="text-3xl font-extrabold text-amber-400 mt-1" id="dash-score">0</h3>
                </div>
                <div class="bg-slate-800 border border-slate-700 p-5 rounded-2xl shadow">
                    <p class="text-xs text-slate-400 uppercase font-semibold">Mastery Mode</p>
                    <h3 class="text-3xl font-extrabold text-sky-400 mt-1">Active Recall</h3>
                </div>
            </div>
            <div class="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg">
                <h2 class="text-xl font-bold mb-3 text-white">🚀 Quick Launch Training</h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <button onclick="switchTab('mcq'); initMCQ();" class="p-5 bg-gradient-to-br from-emerald-600 to-teal-700 rounded-xl font-bold text-left shadow">
                        <div class="text-2xl mb-2">🎯</div><div class="text-lg">Multiple Choice Quiz</div>
                    </button>
                    <button onclick="switchTab('root'); initRootQuiz();" class="p-5 bg-gradient-to-br from-indigo-600 to-blue-700 rounded-xl font-bold text-left shadow">
                        <div class="text-2xl mb-2">🔍</div><div class="text-lg">Root Word Detective</div>
                    </button>
                    <button onclick="switchTab('speed'); initSpeedMatch();" class="p-5 bg-gradient-to-br from-amber-600 to-orange-700 rounded-xl font-bold text-left shadow">
                        <div class="text-2xl mb-2">⚡</div><div class="text-lg">Speed Match Attack</div>
                    </button>
                </div>
            </div>
        </section>
        <section id="tab-mcq" class="hidden max-w-2xl mx-auto space-y-6">
            <div class="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg">
                <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-700">
                    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Multiple Choice Quiz</span>
                </div>
                <div class="text-center py-6">
                    <p class="text-xs text-slate-400 mb-2">What is the meaning of this Quranic word?</p>
                    <h2 class="arabic text-5xl font-bold text-white mb-3" id="mcq-word">---</h2>
                    <p class="text-sm text-indigo-300 italic" id="mcq-translit">---</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4" id="mcq-options"></div>
                <div class="mt-6 flex justify-between items-center pt-4 border-t border-slate-700">
                    <span class="text-sm font-medium text-slate-300">Score: <strong class="text-emerald-400" id="mcq-score">0</strong></span>
                    <button onclick="initMCQ()" class="px-5 py-2 bg-emerald-600 text-white font-semibold rounded-xl text-sm shadow">Next Question ➔</button>
                </div>
            </div>
        </section>
        <section id="tab-root" class="hidden max-w-2xl mx-auto space-y-6">
            <div class="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg">
                <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-700">
                    <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Root Word Detective</span>
                </div>
                <div class="text-center py-6">
                    <p class="text-xs text-slate-400 mb-2">Find the correct 3-letter Arabic root for:</p>
                    <h2 class="arabic text-4xl font-bold text-white mb-2" id="root-word">---</h2>
                    <p class="text-sm text-slate-300" id="root-meaning">Meaning: ---</p>
                </div>
                <div class="grid grid-cols-2 gap-3 mt-4" id="root-options"></div>
                <div class="mt-6 flex justify-between items-center pt-4 border-t border-slate-700">
                    <span class="text-sm font-medium text-slate-300">Score: <strong class="text-indigo-400" id="root-score">0</strong></span>
                    <button onclick="initRootQuiz()" class="px-5 py-2 bg-indigo-600 text-white font-semibold rounded-xl text-sm shadow">Next Word ➔</button>
                </div>
            </div>
        </section>
        <section id="tab-speed" class="hidden max-w-2xl mx-auto space-y-6">
            <div class="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg text-center">
                <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-700">
                    <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Speed Match / Time Attack</span>
                    <span class="text-sm font-bold text-amber-400 bg-amber-950/50 px-3 py-1 rounded-full border border-amber-700/50" id="speed-timer">⏱️ 30s</span>
                </div>
                <div id="speed-game-area" class="py-4">
                    <div class="mb-6">
                        <p class="text-xs text-slate-400 mb-1">Match this Arabic word:</p>
                        <h2 class="arabic text-5xl font-bold text-white mb-2" id="speed-word">---</h2>
                        <p class="text-xs text-indigo-300 italic" id="speed-translit">---</p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="speed-options"></div>
                </div>
                <div id="speed-start-area" class="py-10">
                    <h3 class="text-2xl font-bold mb-3 text-white">Ready for the 30-Second Challenge?</h3>
                    <button onclick="startSpeedGame()" class="px-8 py-3 bg-amber-600 text-white font-bold rounded-xl text-lg shadow-lg">Start Game 🚀</button>
                </div>
                <div class="mt-4 pt-4 border-t border-slate-700 flex justify-between items-center">
                    <span class="text-sm font-medium text-slate-300">Score: <strong class="text-amber-400" id="speed-score">0</strong></span>
                    <button onclick="resetSpeedGame()" class="text-xs text-slate-400 underline">Reset</button>
                </div>
            </div>
        </section>
        <section id="tab-browser" class="hidden space-y-6">
            <div class="bg-slate-800 border border-slate-700 p-6 rounded-2xl shadow-lg">
                <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-white">Complete Vocabulary Database</h2>
                        <p class="text-xs text-slate-400">Search across all 3,680 words, roots, and meanings</p>
                    </div>
                    <div class="w-full sm:w-72">
                        <input type="text" id="search-input" oninput="filterBrowser()" placeholder="Search word, root, Tamil..." class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:border-emerald-500">
                    </div>
                </div>
                <div class="overflow-x-auto rounded-xl border border-slate-700 max-h-[600px]">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead class="bg-slate-900 text-slate-400 text-xs uppercase sticky top-0 border-b border-slate-700">
                            <tr>
                                <th class="p-3 font-semibold w-16">#</th>
                                <th class="p-3 font-semibold">Arabic Word</th>
                                <th class="p-3 font-semibold">Root Word</th>
                                <th class="p-3 font-semibold">English Meaning</th>
                                <th class="p-3 font-semibold">Tamil Meaning</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700/50" id="browser-tbody"></tbody>
                    </table>
                </div>
                <div class="mt-4 flex justify-between items-center text-xs text-slate-400">
                    <span id="browser-count">Showing 3,680 words</span>
                    <div class="space-x-2">
                        <button onclick="changePage(-1)" class="px-3 py-1 bg-slate-700 rounded text-white">Previous</button>
                        <span id="page-indicator">Page 1</span>
                        <button onclick="changePage(1)" class="px-3 py-1 bg-slate-700 rounded text-white">Next</button>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <script>
        const vocabData = [{"id": 1, "arabic": "مِن (Min)", "root": "م-ن", "english": "From", "tamil": "இலிருந்து / இருந்து"}, {"id": 2, "arabic": "اللَّه (Allah)", "root": "أ-ل-ه", "english": "God / The One God", "tamil": "அல்லாஹ் / இறைவன்"}, {"id": 3, "arabic": "فِي (Fi)", "root": "ف-ي", "english": "In / Into", "tamil": "இல் / உள்ளே"}, {"id": 4, "arabic": "مَا (Ma)", "root": "م-ي-و", "english": "What / Not", "tamil": "என்ன / இல்லை"}, {"id": 5, "arabic": "لَا (La)", "root": "ل-ي", "english": "No / Not", "tamil": "இல்லை"}, {"id": 6, "arabic": "إِنَّ (Inna)", "root": "أ-ن-ن", "english": "Indeed / Surely", "tamil": "நிச்சயமாக"}, {"id": 7, "arabic": "إِلَى (Ila)", "root": "أ-ل-ي", "english": "To / Towards", "tamil": "பக்கம் / அளவில்"}, {"id": 8, "arabic": "عَلَى ('Ala)", "root": "ع-ل-و", "english": "On / Upon", "tamil": "மீது / மேல்"}, {"id": 9, "arabic": "الَّذِينَ (Allatheena)", "root": "ل-ذ-ي", "english": "Those who", "tamil": "எவர்கள்"}, {"id": 10, "arabic": "كُلّ (Kull)", "root": "ك-ل-ل", "english": "All / Every", "tamil": "எல்லாம் / ஒவ்வொரு"}];
        let globalScore = 0, currentPage = 1, pageSize = 50, filteredVocab = [...vocabData];
        function switchTab(tabId) {
            ['dashboard', 'mcq', 'root', 'speed', 'browser'].forEach(id => document.getElementById(`tab-${id}`).classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            if (tabId === 'mcq') initMCQ();
            if (tabId === 'root') initRootQuiz();
            if (tabId === 'browser') renderBrowser();
        }
        let currentMCQCorrect = null;
        function initMCQ() {
            const correctItem = vocabData[Math.floor(Math.random() * vocabData.length)];
            currentMCQCorrect = correctItem;
            let wrongOptions = vocabData.filter(i => i.id !== correctItem.id).sort(() => 0.5 - Math.random()).slice(0, 3);
            let options = [...wrongOptions, correctItem].sort(() => 0.5 - Math.random());
            document.getElementById('mcq-word').innerText = correctItem.arabic;
            document.getElementById('mcq-translit').innerText = `Root: ${correctItem.root}`;
            const optionsContainer = document.getElementById('mcq-options');
            optionsContainer.innerHTML = '';
            options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "p-4 bg-slate-900 border border-slate-700 rounded-xl text-left hover:bg-slate-700 transition font-medium text-sm flex flex-col gap-1";
                btn.innerHTML = `<span class="text-slate-200 font-semibold">${opt.tamil}</span><span class="text-xs text-slate-400">${opt.english}</span>`;
                btn.onclick = () => checkMCQAnswer(opt.id, correctItem.id, btn);
                optionsContainer.appendChild(btn);
            });
        }
        function checkMCQAnswer(selectedId, correctId, btnElement) {
            const buttons = document.querySelectorAll('#mcq-options button');
            buttons.forEach(b => b.disabled = true);
            if (selectedId === correctId) {
                btnElement.className = "p-4 bg-emerald-900/80 border border-emerald-500 rounded-xl text-left font-medium text-sm flex flex-col gap-1 shadow";
                globalScore++;
                document.getElementById('dash-score').innerText = globalScore;
                document.getElementById('mcq-score').innerText = globalScore;
            } else {
                btnElement.className = "p-4 bg-rose-900/80 border border-rose-500 rounded-xl text-left font-medium text-sm flex flex-col gap-1 shadow";
            }
        }
        function initRootQuiz() {
            const correctItem = vocabData[Math.floor(Math.random() * vocabData.length)];
            document.getElementById('root-word').innerText = correctItem.arabic;
            document.getElementById('root-meaning').innerText = `Meaning: ${correctItem.tamil} (${correctItem.english})`;
            const container = document.getElementById('root-options');
            container.innerHTML = '';
            [correctItem.root, "م-ن", "أ-ل-ه", "ف-ي"].sort(() => 0.5 - Math.random()).forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "p-4 bg-slate-900 border border-slate-700 rounded-xl text-center hover:bg-slate-700 transition font-mono font-bold text-lg text-indigo-300";
                btn.innerText = opt;
                btn.onclick = () => {
                    if(opt === correctItem.root) { globalScore++; document.getElementById('root-score').innerText = globalScore; btn.className = "p-4 bg-emerald-900 border border-emerald-500 rounded-xl text-center font-mono font-bold text-lg text-white"; }
                    else { btn.className = "p-4 bg-rose-900 border border-rose-500 rounded-xl text-center font-mono font-bold text-lg text-white"; }
                };
                container.appendChild(btn);
            });
        }
        let speedTimer = 30, speedInterval = null, speedScoreVal = 0;
        function startSpeedGame() {
            document.getElementById('speed-start-area').classList.add('hidden');
            speedTimer = 30; speedScoreVal = 0;
            document.getElementById('speed-score').innerText = speedScoreVal;
            speedInterval = setInterval(() => {
                speedTimer--;
                document.getElementById('speed-timer').innerText = `⏱️ ${speedTimer}s`;
                if (speedTimer <= 0) { clearInterval(speedInterval); alert("Game Over! Score: " + speedScoreVal); }
            }, 1000);
            nextSpeedRound();
        }
        function nextSpeedRound() {
            if (speedTimer <= 0) return;
            const correctItem = vocabData[Math.floor(Math.random() * vocabData.length)];
            document.getElementById('speed-word').innerText = correctItem.arabic;
            document.getElementById('speed-translit').innerText = `Root: ${correctItem.root}`;
            const container = document.getElementById('speed-options');
            container.innerHTML = '';
            [vocabData[0], vocabData[1], vocabData[2], correctItem].sort(() => 0.5 - Math.random()).forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "p-4 bg-slate-900 border border-slate-700 rounded-xl text-left hover:bg-slate-700 transition font-medium text-sm";
                btn.innerText = opt.tamil;
                btn.onclick = () => { if(opt.id === correctItem.id) { speedScoreVal++; document.getElementById('speed-score').innerText = speedScoreVal; } nextSpeedRound(); };
                container.appendChild(btn);
            });
        }
        function resetSpeedGame() { clearInterval(speedInterval); document.getElementById('speed-start-area').classList.remove('hidden'); }
        function renderBrowser() {
            const tbody = document.getElementById('browser-tbody');
            tbody.innerHTML = '';
            filteredVocab.slice((currentPage-1)*pageSize, currentPage*pageSize).forEach(item => {
                tbody.innerHTML += `<tr class="hover:bg-slate-700/30 transition"><td class="p-3 text-slate-400">${item.id}</td><td class="p-3 arabic text-lg font-bold text-emerald-300">${item.arabic}</td><td class="p-3 font-mono text-indigo-300">${item.root}</td><td class="p-3">${item.english}</td><td class="p-3 font-semibold">${item.tamil}</td></tr>`;
            });
        }
        function filterBrowser() {
            const query = document.getElementById('search-input').value.toLowerCase();
            filteredVocab = vocabData.filter(i => i.arabic.toLowerCase().includes(query) || i.tamil.toLowerCase().includes(query));
            currentPage = 1; renderBrowser();
        }
        function changePage(dir) { if(currentPage + dir >= 1) { currentPage += dir; renderBrowser(); } }
    </script>
</body>
</html>
